{
  "name": "trommel-monorepo",
  "private": true,
  "description": "Trommel: self-hostable CI test intelligence",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "check:deps": "node scripts/check-zero-deps.ts",
    "check:dco": "node scripts/check-dco.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
